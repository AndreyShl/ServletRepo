<web-app>
    <display-name>Archetype Created Web Application</display-name>

        <filter>
            <filter-name>LogFilter</filter-name>
            <filter-class>com.acadamy.filter.LogFilter</filter-class>
        </filter>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.acadamy.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>com.acadamy.controller.RegistrationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BooksPageServlet</servlet-name>
        <servlet-class>com.acadamy.controller.BooksPageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookServlet</servlet-name>
        <servlet-class>com.acadamy.controller.BookServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MainServlet</servlet-name>
        <servlet-class>com.acadamy.controller.MainServlet</servlet-class>
    </servlet>


    <servlet-mapping>
        <servlet-name>MainServlet</servlet-name>
        <url-pattern>/main</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookServlet</servlet-name>
        <url-pattern>/book</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BooksPageServlet</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/registration</url-pattern>
    </servlet-mapping>
        <filter-mapping>
            <filter-name>LogFilter</filter-name>
            <url-pattern>/books</url-pattern>
        </filter-mapping>

</web-app>
